# Copiar este archivo como .env y completar los valores.
# Para desarrollo local también se acepta SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5432/TU_DB

# JWT: clave de al menos 32 caracteres.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
